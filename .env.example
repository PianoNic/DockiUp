# Copy to .env and fill in.

# Password for DockiUp's database.
POSTGRES_PASSWORD=change-me

# Encrypts stored secrets and Git credentials. Create one with: openssl rand -base64 32
VAULT_MASTER_KEY=

# Optional: the address other hosts reach DockiUp at. Only needed to add nodes.
# PUBLIC_URL=https://dockiup.example.com
